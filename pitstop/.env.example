# Copie para .env.local. VITE_ vai para o navegador; o resto só no servidor.
# Contrato e detalhes: docs/BACKEND.md
# VITE_LEAD_ENDPOINT=/api/lead
# VITE_RANKING_ENDPOINT=/api/ranking

# Destino do lead: pelo menos um dos dois. Sem destino, /api/lead responde 503
# e o app mantém o cadastro na fila.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
LEAD_SUPABASE=

# Ranking (e leads, se LEAD_SUPABASE=1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
