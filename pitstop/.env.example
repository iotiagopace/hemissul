# Copie para .env.local. VITE_ vai para o navegador; o resto só no servidor.
# Contrato e detalhes: docs/BACKEND.md
# VITE_LEAD_ENDPOINT=/api/lead
# VITE_RANKING_ENDPOINT=/api/ranking

# Banco do Pitstop (leads e ranking). Sem ele, /api/lead responde 503 e o app
# mantém o cadastro na fila. Não há envio a CRM.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Acesso do time da Hemissul à consulta e exportação (fechado se vazio)
SUPABASE_ANON_KEY=
PITSTOP_ADMIN_EMAILS=
