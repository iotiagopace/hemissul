# ──────────────────────────────────────────────────────────────
# DRIVER DO BANCO
# Escolha um: mysql | postgres | supabase | sqlite | turso
# ──────────────────────────────────────────────────────────────
DB_DRIVER=mysql


# ── OPÇÃO A: MySQL (Hostgator, Locaweb, AWS RDS, etc.) ────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=hemissul_cms


# ── OPÇÃO B: Postgres / Supabase ──────────────────────────────
# Pegue a connection string em: Supabase → Project Settings → Database → Connection Pooling
# Cole inteira em DB_URL e deixe DB_HOST/USER/PASS em branco.
# DB_DRIVER=supabase
# DB_URL=postgres://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres


# ── OPÇÃO C: Turso (SQLite serverless) ────────────────────────
# DB_DRIVER=turso
# DB_URL=libsql://seu-banco.turso.io
# DB_TOKEN=eyJhbGciOi...


# ── OPÇÃO D: SQLite local (arquivo) ──────────────────────────
# DB_DRIVER=sqlite
# DB_URL=file:./hemissul.db


# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=troque_por_string_aleatoria_longa_aqui

# ── Servidor ──────────────────────────────────────────────────
PORT=3001

# ── CORS — domínios do site público e do admin ───────────────
ALLOWED_ORIGINS=https://hemissul.com.br,https://hemissul.vercel.app,http://localhost:5173

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_MB=8
PUBLIC_URL=http://localhost:3001
